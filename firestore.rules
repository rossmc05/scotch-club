rules_version = '2';

// Scotch Club — shared bottle log. No logins: anyone with the link can view and add.
// These rules keep the data tidy (right fields, sensible sizes) and stop
// distilleries or the seed marker from being deleted.
service cloud.firestore {
  match /databases/{database}/documents {

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    match /bottles/{id} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(
          ['host', 'whisky', 'distilleryId', 'date', 'image', 'addedAt', 'updatedAt', 'seeded', 'seq'])
        && str(request.resource.data.host, 1, 40)
        && str(request.resource.data.whisky, 1, 150)
        && str(request.resource.data.distilleryId, 1, 80)
        && str(request.resource.data.date, 0, 10)
        && str(request.resource.data.image, 0, 600);
      allow delete: if true;
    }

    match /distilleries/{id} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['name', 'region', 'country', 'lat', 'lng', 'address'])
        && str(request.resource.data.name, 1, 100)
        && str(request.resource.data.region, 1, 40)
        && str(request.resource.data.country, 0, 60)
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;
      allow delete: if false;
    }

    match /meta/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
